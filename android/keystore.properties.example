# Copy to android/keystore.properties (gitignored) and fill in.
# Values live in Codemagic → your app → Environment variables:
#   storePassword = CM_KEYSTORE_PASSWORD  (signing / "akey" group)
#   keyAlias      = CM_KEY_ALIAS
#   keyPassword   = CM_KEY_PASSWORD (often identical to storePassword)
storeFile=/Users/rs-mac/.android-keys/crfkey.jks
storePassword=
keyAlias=
keyPassword=
