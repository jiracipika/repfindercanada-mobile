# Copy to fastlane/.env (gitignored — fastlane auto-loads it) and fill in.
ASC_ISSUER_ID=
# App Store Connect → Users and Access → Integrations → App Store Connect API → Issuer ID

PLAY_SERVICE_ACCOUNT_JSON=
# Path to the Google Play service-account JSON. Source options:
#   1. Codemagic → Environment variables → "google_play" group → GCLOUD_SERVICE_ACCOUNT_CREDENTIALS (copy the JSON value into a file)
#   2. Play Console → Setup → API access → link/create service account → Keys → download JSON

PLAY_TRACK=internal
# internal | alpha | beta | production
